#cloud-config
hostname: {{.Hostname}}
timezone: {{.Timezone}}
package_update: true
package_upgrade: true
packages: [openssh-server, sudo, ufw, fail2ban, unattended-upgrades]
ssh_pwauth: false
disable_root: true
ssh_deletekeys: true
ssh_genkeytypes: [ed25519, rsa]
users:
  - name: {{.Administrator}}
    shell: /bin/bash
    groups: [adm, sudo]
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - {{.SSHPublicKeyMaterial}}
write_files:
  - path: /etc/ssh/sshd_config.d/60-vpsmith-primary.conf
    owner: root:root
    permissions: '0644'
    defer: true
    content: |
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PubkeyAuthentication yes
      AuthenticationMethods publickey
      PermitEmptyPasswords no
      AllowUsers {{.Administrator}}
      LoginGraceTime 20
      MaxAuthTries 3
      MaxSessions 3
      MaxStartups 10:30:60
      X11Forwarding no
      AllowAgentForwarding no
      AllowTcpForwarding no
      AllowStreamLocalForwarding no
      PermitTunnel no
      GatewayPorts no
      PermitUserEnvironment no
      DisableForwarding yes
      Compression no
      LogLevel VERBOSE
  - path: /etc/fail2ban/jail.d/vpsmith-primary.local
    owner: root:root
    permissions: '0644'
    defer: true
    content: |
      [DEFAULT]
      backend = systemd
      banaction = ufw
      banaction_allports = ufw
      bantime = 1h
      findtime = 10m
      maxretry = 4

      [sshd]
      enabled = true
      port = ssh

      [recidive]
      enabled = true
      backend = auto
      logpath = /var/log/fail2ban.log
      bantime = 1w
      findtime = 1d
      maxretry = 3
  - path: /etc/apt/apt.conf.d/52-vpsmith-auto-upgrades
    owner: root:root
    permissions: '0644'
    defer: true
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
      Unattended-Upgrade::Automatic-Reboot "false";
runcmd:
  - |
      set -eu
      export LC_ALL=C
      vpsmith_stage=initialize
      vpsmith_complete=0
      vpsmith_tmp=''
      trap 'rc=$?; if [ -n "$vpsmith_tmp" ]; then rm -f "$vpsmith_tmp"; fi; if [ "$vpsmith_complete" -ne 1 ] && [ "$rc" -ne 0 ]; then printf "vpsmith-primary-failed stage=%s rc=%s\n" "$vpsmith_stage" "$rc" >&2; fi' 0
      vpsmith_mark() { vpsmith_stage=$1; printf 'vpsmith-primary-stage=%s\n' "$vpsmith_stage"; }

      vpsmith_mark clear-status
      rm -f /var/lib/vpsmith/cloud-init/status

      vpsmith_mark lock-root-password
      passwd -l root >/dev/null

      vpsmith_mark apply-ssh
      sshd -t
      systemctl reload ssh.service 2>/dev/null || systemctl reload sshd.service

      vpsmith_mark apply-ufw
      ufw --force reset >/dev/null
      ufw default deny incoming >/dev/null
      ufw default allow outgoing >/dev/null
      ufw default deny routed >/dev/null
      ufw allow 22/tcp >/dev/null
      ufw allow 80/tcp >/dev/null
      ufw allow 443/tcp >/dev/null
      ufw logging low >/dev/null
      ufw --force enable >/dev/null

      vpsmith_mark validate-fail2ban-config
      fail2ban-client -t >/dev/null
      systemctl enable fail2ban.service >/dev/null

      vpsmith_mark restart-fail2ban
      systemctl restart fail2ban.service >/dev/null

      vpsmith_mark enable-unattended-upgrades
      systemctl enable --now unattended-upgrades.service >/dev/null 2>&1 || true

      vpsmith_mark verify-root-password-locked
      root_hash=$(getent shadow root | cut -d: -f2)
      case "$root_hash" in !*|'*'*) ;; *) exit 1 ;; esac

      vpsmith_mark verify-ssh-config
      sshd -t
      ssh_effective=$(sshd -T -C user={{.Administrator}},host=$(hostname),addr=127.0.0.1)
      require_sshd() {
        key=$1
        value=$2
        vpsmith_stage=verify-ssh-$key
        printf '%s\n' "$ssh_effective" | grep -Fxiq "$key $value"
      }
      require_sshd permitrootlogin no
      require_sshd passwordauthentication no
      require_sshd kbdinteractiveauthentication no
      require_sshd pubkeyauthentication yes
      require_sshd authenticationmethods publickey
      require_sshd permitemptypasswords no
      require_sshd logingracetime 20
      require_sshd maxauthtries 3
      require_sshd maxsessions 3
      require_sshd maxstartups 10:30:60
      require_sshd x11forwarding no
      require_sshd allowagentforwarding no
      require_sshd allowtcpforwarding no
      require_sshd allowstreamlocalforwarding no
      require_sshd permittunnel no
      require_sshd gatewayports no
      require_sshd permituserenvironment no
      require_sshd compression no
      require_sshd loglevel VERBOSE
      vpsmith_mark verify-ssh-allowusers
      printf '%s\n' "$ssh_effective" | grep -Eq '^allowusers([[:space:]]+){{.Administrator}}$'

      vpsmith_mark verify-ufw-status
      ufw_status=$(ufw status verbose)
      printf '%s\n' "$ufw_status" | grep -Fxq 'Status: active'
      vpsmith_mark verify-ufw-defaults
      printf '%s\n' "$ufw_status" | grep -Fq 'Default: deny (incoming), allow (outgoing), deny (routed)'
      vpsmith_mark verify-ufw-logging
      printf '%s\n' "$ufw_status" | grep -Eq '^Logging: on \(low\)$'
      vpsmith_mark verify-ufw-public-ports
      ufw_rules=$(ufw status | awk '$2=="ALLOW" {print $1}' | sort -u | paste -sd, -)
      [ "$ufw_rules" = '22/tcp,443/tcp,80/tcp' ] || [ "$ufw_rules" = '22/tcp,80/tcp,443/tcp' ]

      vpsmith_mark verify-fail2ban-service
      systemctl is-active --quiet fail2ban.service
      vpsmith_mark verify-fail2ban-sshd
      fail2ban-client status sshd >/dev/null
      vpsmith_mark verify-fail2ban-recidive
      fail2ban-client status recidive >/dev/null

      vpsmith_mark verify-unattended-upgrades
      [ "$(apt-config shell x APT::Periodic::Unattended-Upgrade | sed -n "s/^x='\(.*\)'$/\1/p")" = 1 ]
      vpsmith_mark verify-automatic-reboot-disabled
      [ "$(apt-config shell x Unattended-Upgrade::Automatic-Reboot | sed -n "s/^x='\(.*\)'$/\1/p")" = false ]

      vpsmith_mark write-success-status
      install -d -m 0755 /var/lib/vpsmith/cloud-init
      vpsmith_tmp=$(mktemp /var/lib/vpsmith/cloud-init/.status.XXXXXX)
      { printf 'status=ok\n'; printf 'version={{.DefinitionVersion}}\n'; printf 'finished_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"; } >"$vpsmith_tmp"
      chmod 0644 "$vpsmith_tmp"
      mv -f "$vpsmith_tmp" /var/lib/vpsmith/cloud-init/status
      vpsmith_tmp=''
      vpsmith_complete=1
